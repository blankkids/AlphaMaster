# 复制为 .env 并填入真实值（.env 已在 .gitignore 中，不会上传 GitHub）
#
# Web 控制台登录（WEB_AUTH_PASSWORD 必填；未配置时拒绝访问）
WEB_AUTH_USERNAME=admin
WEB_AUTH_PASSWORD=
# 可选：独立会话签名密钥；留空时会从登录密码派生
WEB_AUTH_SECRET=
# 会话有效期（小时，范围 1～720）
WEB_AUTH_SESSION_HOURS=12
# 仅在 HTTPS 部署时设为 true
WEB_AUTH_COOKIE_SECURE=false

# MT5 实盘 / 数据拉取（run.py、live_trade.py、download_full_history.py 等）
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Demo
